# Where the dashboard sends API calls at runtime.
#   /dashboard-api  — a reverse proxy in front of Honcho injects the API token
#                     server-side (recommended: the browser never holds a key)
#   https://…       — talk to Honcho directly; the console will ask for an API
#                     key and keep it in this browser only
VITE_API_BASE=/dashboard-api

# Path the app is served from. Use "/" if it sits at the domain root.
VITE_BASE_PATH=/dashboard/

# Workspace opened on first visit.
VITE_DEFAULT_WORKSPACE=default

# Which peer ids are software rather than people, as a regex. These get a
# distinct avatar so an agent is never mistaken for a customer.
VITE_AGENT_PATTERN=^(assistant|agent|bot|ai)\b

# --- local development only, never committed ---
# Upstream Honcho for `npm run dev` to proxy to.
HONCHO_PROXY_TARGET=
HONCHO_PROXY_USER=
HONCHO_PROXY_PASS=
